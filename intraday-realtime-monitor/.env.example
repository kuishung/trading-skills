# Copy to <vault>/intraday-realtime.env, or let the skill auto-detect.
# Reuses Alpaca credentials from <vault>/alpaca.env (set up via the
# alpaca-trader-paper skill); this file only adds skill-specific keys.

# Optional: Telegram bot for entry/exit alerts. Can be the same bot as
# MATP / intraday-premarket-brief, or a separate one.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: daily risk caps (override built-in defaults)
# DAILY_LOSS_PCT_LIMIT=-2.0
# MAX_TRADES_PER_DAY=5
# MAX_CONCURRENT_POSITIONS=3
# RISK_PCT_PER_TRADE=0.5
