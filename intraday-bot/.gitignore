config.json
__pycache__/
*.pyc

# Per-PC Windows shortcuts -- absolute paths, regenerated by
# dashboard/setup_launcher.py once per PC.
dashboard/*.lnk

# Vendored TradingView MCP -- per-PC npm install artifacts
resources/tradingview-mcp/node_modules/
resources/tradingview-mcp/package-lock.json

# Copyrighted strategy reference material — synced via Dropbox, not git
strategy/GUNS/Materials/

# data/ — the cream. journals + review snapshots + fixtures ARE committed;
# bulk historical bars are regeneratable from IBKR/TV/yfinance (Dropbox-synced).
data/price_history/

# IBC bundle — contains plaintext IBKR credentials, must NEVER be committed
ibc/credentials.txt
ibc/*.log
ibc/Logs/

# Scratch logs from ingest CLIs + dashboard server. Real progress lives in
# data/price_history/<tf>/<SYM>.parquet + the journal.
data/_*.log
dashboard/dashboard.log
state/bot_*.log
state/intraday_*.log
state/scanner_*.log
state/autoplan_*.log

# Dev-only safety backups (e.g. anything ".polluted_by_smoke")
*.polluted_by_*
