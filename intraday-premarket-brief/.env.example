# Copy to .env (or run scripts/setup.py to populate interactively).
# .env is gitignored.

# Required: the Finviz intraday-mover screener URL to scan every run.
# Keep query params but you can drop the &r=<N> pagination offset — the
# brief paginates itself. The &preset= param can stay.
INTRADAY_FINVIZ_URL=

# Optional: Telegram bot credentials for --send-telegram.
# Get a token from @BotFather; chat ID from @userinfobot or by hitting
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# after sending one message to your bot. Leave blank to disable Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
