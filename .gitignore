# Credentials — never commit, at any depth
.env
.env.*
!.env.example
*.pem
*.key
*-sa.json
*-service-account*.json
service_account*.json
credentials/
**/credentials/
Google Key/
**/Google Key/
.gcp/
**/.gcp/

# Claude Code local settings
.claude/settings.local.json
**/.claude/settings.local.json

# Per-skill local state (not source)
trade_log.jsonl
config.json

# Generated outputs (regeneratable, don't commit)
MATP_table.csv
MATP_analysis.md
MATP_indicator.pine
MATP_watchlist.txt

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# Virtualenvs
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp

# Locally installed MCP servers at the trading-skills ROOT level only.
# Anchored leading slash so this rule does NOT swallow vendored copies
# nested inside skills (e.g. intraday-bot/resources/tradingview-mcp/
# is intentionally committed; its own node_modules is gitignored via
# intraday-bot/.gitignore).
/tradingview-mcp/
node_modules/

# Claude Code MCP project config — contains absolute paths to local MCP
# servers that vary per machine / per worktree. Use .mcp.json.example as
# the committed template; copy to .mcp.json and edit paths locally.
.mcp.json

# OS
.DS_Store
Thumbs.db
desktop.ini
