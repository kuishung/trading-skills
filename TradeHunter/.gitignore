state/watchlist_*.txt
state/watchlist_*.json
state/plan_*.json
state/fills_*.jsonl
state/equity_*.json
state/events_*.jsonl
state/cache/
state/shortlist_*.json
state/armed.flag
state/armed_*.flag
state/enabled_*.flag
state/auto_started_*.flag
state/_*
state/sample_charts/
config.json
__pycache__/
*.pyc

# Per-PC Windows shortcuts -- absolute paths, regenerated by
# dashboard_intraday/setup_launcher.py + dashboard_tst/setup_launcher.py
# once per PC.
dashboard_intraday/*.lnk
dashboard_tst/*.lnk

# Archived old dashboard layout (2026-05-27 wipe). Kept on disk for
# snippet salvage during the rebuild; not committed because we don't
# want git to track a dead file that grows stale relative to the live
# index.html. Delete locally once the rebuild is far enough along that
# you don't need to reference the old panels.
dashboard_intraday/web/index.html.old
dashboard_tst/web/index.html.old

# Vendored TradingView MCP -- per-PC npm install artifacts
resources/tradingview-mcp/node_modules/
resources/tradingview-mcp/package-lock.json

# Copyrighted strategy reference material — synced via Dropbox, not git
strategy/GUNS/Materials/

# data/ — the cream. journals + review snapshots + fixtures ARE committed;
# bulk historical bars are regeneratable from IBKR/TV/yfinance (Dropbox-synced).
data/price_history/

# Per-ticker behavioral profiles (ATR / vol / 3m percentiles). Derived
# nightly from data/price_history/*.parquet; TTL 24h; regenerable;
# Dropbox-synced across PCs. Same lifecycle as price_history.
data/ticker_profile/

# IBC bundle — contains plaintext IBKR credentials, must NEVER be committed
ibc/credentials.txt
ibc/*.log
ibc/Logs/

# Scratch logs from ingest CLIs + dashboard server. Real progress lives in
# data/price_history/<tf>/<SYM>.parquet + the journal.
data/_*.log
dashboard_intraday/dashboard.log
dashboard_tst/dashboard.log
state/bot_*.log
state/intraday_*.log
state/scanner_*.log
state/autoplan_*.log

# Dev-only safety backups (e.g. anything ".polluted_by_smoke")
*.polluted_by_*
