# dashboard_tst platform env. Copy to .env (gitignored) and fill in.
# Generate a strong secret:  python -c "import secrets; print(secrets.token_hex(32))"
TST_SECRET_KEY=change-me

# Dev/VPN default is SQLite. For a bigger deployment point at Postgres:
#   TST_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/tst
TST_DATABASE_URL=sqlite:///./tst.db

# --- Auth mode ---
#   password = Path B (default): admin creates accounts; access gated by the
#              Hamachi VPN + login. No domain/TLS/Google needed.
#   google   = Path A: Google OAuth + admin approval. Needs an https domain
#              (Google rejects bare/private IPs as redirect URIs).
TST_AUTH_MODE=password

# Admin bootstrap.
#   password mode: these seed an approved admin on first startup.
#   google mode:   TST_ADMIN_EMAIL is auto-promoted to admin on first sign-in.
TST_ADMIN_EMAIL=you@example.com
TST_ADMIN_PASSWORD=change-me-too

# New-user policy (google mode). 0 (default): a first-time sign-in lands
# 'pending' (role member) and must be approved by an admin in the console
# before getting access. 1: new users become active members automatically.
TST_AUTO_APPROVE=0

# --- Google OAuth (only used when TST_AUTH_MODE=google; Path A) ---
# Create a Web-application OAuth client in Google Cloud Console; redirect:
#   https://<your-domain>/auth/callback
# TST_GOOGLE_CLIENT_ID=
# TST_GOOGLE_CLIENT_SECRET=
# TST_OAUTH_REDIRECT_URI=https://<your-domain>/auth/callback
# TST_ALLOWED_EMAIL_DOMAINS=

# --- Machine API (Nous Hermes agent -> /api/matp) ---
# Shared key the Nous Hermes agent sends as the X-API-Key header to push MATP
# levels. Unset -> /api/* returns 503 (feature off). Generate a strong one:
#   python -c "import secrets; print(secrets.token_hex(32))"
# TST_INGEST_API_KEY=

# Where to archive each MATP run as a JSON file (raw extraction, the "cream").
# On Hermes point this at the Resilio-synced MarketData path. Empty -> defaults
# to <TradeHunter>/data/MATP.
# TST_MATP_DIR=C:\HermesSync\MarketData\MATP

# --- Discord notifications (outbound webhook) ---
# Posts a summary to a Discord channel when a MATP refresh completes. Create it:
# Discord -> Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy
# URL. Unset -> notifications are silently skipped.
# TST_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXX/YYYY
# Public base URL used to build click-through links in those notifications
# (the agent calls the API server-side, so we can't infer it from the request).
# TST_PUBLIC_URL=https://tradehunter.net

# --- Options module (the /options page and its nightly job) ---
# Source of record for option chains. cboe = the free delayed CDN feed (has a
# 30-day IV figure); alpaca = the paper-account feed (needs the Alpaca keys the
# bot already has; no iv30, our own ATM figure is used instead). A typo here makes
# the nightly job exit 1 with one clear line rather than failing per symbol.
TST_OPTIONS_SOURCE=cboe
# Tried once per symbol when the primary source fails: alpaca or cboe. Unset = off.
# TST_OPTIONS_FALLBACK=alpaca
# Alpaca options feed: indicative (free) or opra (Algo Trader Plus subscription only).
# TST_ALPACA_FEED=indicative
# How many days of end-of-day chain snapshots to keep (option_store.prune), and how
# many of those days are kept at full width before deep out-of-the-money / in-the-
# money rows are thinned. Defaults 90 and 7.
# TST_OPTIONS_SNAPSHOT_DAYS=90
# TST_OPTIONS_FULL_DAYS=7
# IV-history seed from IB Gateway / TWS on THIS box (v4.131): when a basket ticker
# is short of the 60 readings an IV rank needs, a year of daily IV is pulled through
# deploy/iv_seed_ibkr.py (a subprocess) the moment it is added, and nightly. Skipped,
# and said so on the status strip, when nothing answers on the port.
# TST_IBKR_PORT=4002        # unset = probe 4002, 4001, 7497, 7496 (Gateway paper/live, TWS paper/live)
# TST_IV_SEED_IBKR=0        # only to switch the seed off
# TST_IBKR_PYTHON=py -3.12  # unset = this app's own interpreter, then py -3.12 (needs ib_insync + the app's packages)

# Keep 0 over a Hamachi VPN on plain http (the VPN tunnel is already
# encrypted). Set 1 only when actually served over TLS.
TST_HTTPS_ONLY=0

# Verbose / reload-friendly mode.
TST_DEBUG=0
