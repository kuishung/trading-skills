# dashboard_tst platform env. Copy to .env (gitignored) and fill in.
# Generate a strong secret:  python -c "import secrets; print(secrets.token_hex(32))"
TST_SECRET_KEY=change-me

# Dev/VPN default is SQLite. For a bigger deployment point at Postgres:
#   TST_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/tst
TST_DATABASE_URL=sqlite:///./tst.db

# --- Auth mode ---
#   password = Path B (default): admin creates accounts; access gated by the
#              Hamachi VPN + login. No domain/TLS/Google needed.
#   google   = Path A: Google OAuth + admin approval. Needs an https domain
#              (Google rejects bare/private IPs as redirect URIs).
TST_AUTH_MODE=password

# Admin bootstrap.
#   password mode: these seed an approved admin on first startup.
#   google mode:   TST_ADMIN_EMAIL is auto-promoted to admin on first sign-in.
TST_ADMIN_EMAIL=you@example.com
TST_ADMIN_PASSWORD=change-me-too

# New-user policy (google mode). 0 (default): a first-time sign-in lands
# 'pending' (role member) and must be approved by an admin in the console
# before getting access. 1: new users become active members automatically.
TST_AUTO_APPROVE=0

# --- Google OAuth (only used when TST_AUTH_MODE=google; Path A) ---
# Create a Web-application OAuth client in Google Cloud Console; redirect:
#   https://<your-domain>/auth/callback
# TST_GOOGLE_CLIENT_ID=
# TST_GOOGLE_CLIENT_SECRET=
# TST_OAUTH_REDIRECT_URI=https://<your-domain>/auth/callback
# TST_ALLOWED_EMAIL_DOMAINS=

# --- Machine API (Nous Hermes agent -> /api/matp) ---
# Shared key the Nous Hermes agent sends as the X-API-Key header to push MATP
# levels. Unset -> /api/* returns 503 (feature off). Generate a strong one:
#   python -c "import secrets; print(secrets.token_hex(32))"
# TST_INGEST_API_KEY=

# Where to archive each MATP run as a JSON file (raw extraction, the "cream").
# On Hermes point this at the Resilio-synced MarketData path. Empty -> defaults
# to <TradeHunter>/data/MATP.
# TST_MATP_DIR=C:\HermesSync\MarketData\MATP

# --- Discord notifications (outbound webhook) ---
# Posts a summary to a Discord channel when a MATP refresh completes. Create it:
# Discord -> Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy
# URL. Unset -> notifications are silently skipped.
# TST_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXX/YYYY
# Public base URL used to build click-through links in those notifications
# (the agent calls the API server-side, so we can't infer it from the request).
# TST_PUBLIC_URL=https://tradehunter.net

# --- Options page (v4.134, OPTIONS_V2_DESIGN.md section 13) ---
# Every option and stock figure comes from Massive (formerly Polygon.io): Options
# Starter (the whole-chain snapshot with greeks / IV / open interest, 15 min delayed,
# no bid/ask) and Stocks Basic (free, end-of-day daily bars, ~5 requests a minute).
# The Hermes options collector (deploy/options_collector.py, scheduled task
# TST-Options-Collector) and the page's "Refresh now" read it; nothing touches IBKR.
#
# The Massive API key. It lives ONLY in app\.env on Hermes (gitignored) - never in
# this file, never committed, never pasted into code, a URL or a chat. The client
# sends it only as an "Authorization: Bearer" header and never logs it. In app\.env
# write the whole line with the key after "=" (no quotes). Without it the collector
# reports "TST_MASSIVE_API_KEY is not set on this PC" and looks again every 5 min.
# The web app ("Refresh now", the admin's key-missing badge) reads app\.env only when
# it starts: after adding or changing the key restart BOTH - the web app (the
# canonical deploy script) and the collector (setup_options_collector_task.ps1
# -StartNow). (A key added while the collector runs is also found at its next 5-min
# look, but only when app\.env had no TST_MASSIVE_API_KEY line at all when it started.)
# TST_MASSIVE_API_KEY=
# The API host (default https://api.massive.com). Only tests / a local fake change it.
# TST_MASSIVE_BASE_URL=https://api.massive.com
# Does the plan include bid/ask quotes? 0 (default) = no - Options Starter: prices are
# estimated from each contract's IV and the two bid/ask rules are greyed out. Set 1
# only on a Massive plan with quotes (Options Advanced and up).
TST_MASSIVE_QUOTES=0
# Minutes between the collector's passes over every basket ticker during the US
# session (1-240, default 15). The page's help and status strip read the same value.
TST_OPTIONS_CYCLE_MIN=15
# How many days of end-of-day chain snapshots to keep (option_store.prune, the
# collector's EOD record in option_chain_snapshot), and how many of those days are
# kept at full width before deep out-of-the-money / in-the-money rows are thinned.
# Defaults 90 and 7.
# TST_OPTIONS_SNAPSHOT_DAYS=90
# TST_OPTIONS_FULL_DAYS=7
# (Removed in v4.134 with the IBKR data path - nothing reads them any more; delete
#  them from app\.env: TST_IBKR_PORT, TST_OPTIONS_COLLECTOR_CLIENT_ID,
#  TST_OPTIONS_MAX_LINES. Removed in v4.133: TST_OPTIONS_SOURCE, TST_OPTIONS_FALLBACK,
#  TST_ALPACA_FEED, TST_IV_SEED_IBKR, TST_IBKR_PYTHON.)

# Keep 0 over a Hamachi VPN on plain http (the VPN tunnel is already
# encrypted). Set 1 only when actually served over TLS.
TST_HTTPS_ONLY=0

# Verbose / reload-friendly mode.
TST_DEBUG=0
