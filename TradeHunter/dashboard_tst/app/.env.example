# dashboard_tst platform env. Copy to .env (gitignored) and fill in.
# Generate a strong secret:  python -c "import secrets; print(secrets.token_hex(32))"
TST_SECRET_KEY=change-me

# Dev/VPN default is SQLite. For a bigger deployment point at Postgres:
#   TST_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/tst
TST_DATABASE_URL=sqlite:///./tst.db

# --- Auth mode ---
#   password = Path B (default): admin creates accounts; access gated by the
#              Hamachi VPN + login. No domain/TLS/Google needed.
#   google   = Path A: Google OAuth + admin approval. Needs an https domain
#              (Google rejects bare/private IPs as redirect URIs).
TST_AUTH_MODE=password

# Admin bootstrap.
#   password mode: these seed an approved admin on first startup.
#   google mode:   TST_ADMIN_EMAIL is auto-promoted to admin on first sign-in.
TST_ADMIN_EMAIL=you@example.com
TST_ADMIN_PASSWORD=change-me-too

# --- Google OAuth (only used when TST_AUTH_MODE=google; Path A) ---
# Create a Web-application OAuth client in Google Cloud Console; redirect:
#   https://<your-domain>/auth/callback
# TST_GOOGLE_CLIENT_ID=
# TST_GOOGLE_CLIENT_SECRET=
# TST_OAUTH_REDIRECT_URI=https://<your-domain>/auth/callback
# TST_ALLOWED_EMAIL_DOMAINS=

# Keep 0 over a Hamachi VPN on plain http (the VPN tunnel is already
# encrypted). Set 1 only when actually served over TLS.
TST_HTTPS_ONLY=0

# Verbose / reload-friendly mode.
TST_DEBUG=0
