# dashboard_tst platform env. Copy to .env (gitignored) and fill in.
# Generate a strong secret:  python -c "import secrets; print(secrets.token_hex(32))"
TST_SECRET_KEY=change-me

# Dev default is SQLite. In production point at Postgres:
#   TST_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/tst
TST_DATABASE_URL=sqlite:///./tst.db

# --- Google OAuth (Sign in with Google) ---
# Create an OAuth 2.0 Client ID (type: Web application) in Google Cloud
# Console -> APIs & Services -> Credentials. Add the redirect URI:
#   dev:  http://localhost:8000/auth/callback
#   prod: https://<your-domain>/auth/callback
TST_GOOGLE_CLIENT_ID=
TST_GOOGLE_CLIENT_SECRET=
# Set explicitly in prod (behind TLS the auto-derived URL may be http://):
#   TST_OAUTH_REDIRECT_URI=https://<your-domain>/auth/callback
TST_OAUTH_REDIRECT_URI=

# This Google email is auto-promoted to admin + approved on first sign-in.
TST_ADMIN_EMAIL=you@example.com
# Optional hard gate: only these email domains may create a pending account
# (comma-separated). Leave blank to allow any Google account to request access.
TST_ALLOWED_EMAIL_DOMAINS=

# Set to 1 in production behind TLS so the session cookie is https-only.
TST_HTTPS_ONLY=0

# Verbose / reload-friendly mode.
TST_DEBUG=0
